mqd21: quadrupole, l = 0.71, k1 = kmqd21, aperture_type = elliptical, aperture = 18.16e-3, r0_mag = 15.e-3



mqa: drift, l = 6.86920058362181329E+000, aperture_type = elliptical, aperture = 18.16e-3
mqa1: drift, l = 1.95347170119514524E+000, aperture_type = elliptical, aperture = 18.16e-3
mqa2: drift, l = 4.59154633687524161E+000, aperture_type = elliptical, aperture = 18.16e-3
mqa3: drift, l = 2.52291632698884705E+000, aperture_type = elliptical, aperture = 18.16e-3
mqa4: drift, l = 0.453, aperture_type = elliptical, aperture = 18.16e-3
mqa5: drift, l = 5.867, aperture_type = elliptical, aperture = 18.16e-3


strrf: drift, l = 2.207, aperture_type = elliptical, aperture = 18.16e-3
rfc_d: drift, l = 1, aperture_type = elliptical, aperture = 18.16e-3

mend: marker
mbeg: marker
rfc: rfcavity, l = 1, voltage = 1.12 * 1e6, phi0 = 0.5 - 0.5, harmon = 2802, aperture_type = elliptical, aperture = 18.16e-3
end: marker

!rfc[voltage] = 1.12e6*18

MQA_00: PIPE, L = 0.4, aperture_type = elliptical, aperture = 18.16e-3
MQA_US: PIPE, L = 1.0, aperture_type = elliptical, aperture = 18.16e-3
MQA_DS: PIPE, L = MQA[L] - MQA_US[L] - MQA_00[L]	! DO NOT ADD APERTURE HERE, NON STANDARD PIPE

MAR.INJ: MARKER
MAR.IS: MARKER

MQA1_IL: PIPE, L = MQA1[L], aperture_type = elliptical, aperture = 18.16e-3

IS.HKI01: kicker, l = 0.8, superimpose, ref = MQA1_IL, offset=0, ref_origin=center, ele_origin=center
IS.MAR.HKI: marker, superimpose, ref = IS.HKI01, offset=0.0, ref_origin=center, ele_origin=center

IS.MAR.PT1: MARKER
IS.MAR.PT2: MARKER

mar.sep: marker
mar.off: marker

es.pip01: pipe, l = mqa2[l], aperture_type = elliptical, aperture = 18.16e-3
es.pip02: pipe, l = mqa1[l], aperture_type = elliptical, aperture = 18.16e-3
es.pip03: pipe, l = mqa[l] - 5.1, aperture_type = elliptical, aperture = 18.16e-3
es.pip04: pipe, l = 3.9, aperture_type = elliptical, aperture = 9.08e-3, aperture_at = continuous
es.pip05: pipe, l = 1.2, aperture_type = elliptical, aperture = 9.08e-3, aperture_at = continuous

es.hki00: kicker, l = 0.8

ES.HKI01: ES.HKI00, SUPERIMPOSE, ref = ES.PIP01, offset=-3.6, ref_origin=end, ele_origin=beginning
ES.HKI02: ES.HKI00, SUPERIMPOSE, ref = ES.PIP01, offset=-2.6, ref_origin=end, ele_origin=beginning
ES.HKI03: ES.HKI00, SUPERIMPOSE, ref = ES.PIP02, offset=0, ref_origin=center, ele_origin=center


