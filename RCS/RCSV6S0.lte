! RCSV6S0.lte -- ELEGANT version of RCSV6S0 (EIC Rapid Cycling Synchrotron)
!
! Hand-structured to mirror RCSV6S0.bmad / RCSV6S0.madx line for line
! (same element names, same ArcMain / insertion LINE structure). It
! replaces the earlier flattened file written by Bmad's
! write_lattice_in_foreign_format, which listed every element of the
! ring explicitly.
!
! Units: m, rad, m^-2 (K1), m^-3 (K2), V, Hz.
! Quoted values are ELEGANT RPN expressions; "% ... sto name" lines
! define the variables they use.
!
! APERTURE: every element in RCSV6S0.bmad is elliptical 16 mm except
! the three large-bore straight-section quads (MQF11_LB, QDS_LB,
! QFS_LB, 50 mm). This is modelled with MAXAMP, which sets the aperture
! for all following elements until the next MAXAMP: AP16 at the start
! of the ring, and AP50 / AP16 around each large-bore quad. ELEGANT
! checks it at the exit of every element, which matches Bmad's default
! aperture_at = exit_end. (The flattened file instead used 3685
! zero-length 16 mm ECOL elements, and so also restricted the
! large-bore quads to 16 mm.)
!
! History of the arc cell (see README.md):
!   2026-10-12  CLOB = 0.0126+0.05 m replaces the CLO after the arc BPM;
!               VACT and DSQ each shortened by 0.025 m.
!   2026-10-13  Arc BPM moved from just downstream of each quad to just
!               upstream of the next one (... DSQ, BPM, QLO, quad); its
!               old 0.02 m slot is now the drift SBM, and DSQ is a
!               further 0.02 m shorter.

! ------------------------------------------------------------------
! Magnet strengths (same values as RCSV6S0.bmad / .madx)
! ------------------------------------------------------------------
% 0.5224902877  sto kqfarc
% -0.5581144777 sto kqdarc
% -0.1506746164 sto kmqd11
% 0.3963879526  sto kmqf21
% -0.2864734388 sto kmqd21
% 0.2555181781  sto kqfs_lb
% 0.173888618   sto kmqf11_lb
% -0.1716855348 sto kqds_lb
% -13.14618404  sto ksfarc
% 23.89445284   sto ksdarc

! Arc dipole: rectangular bend, chord 1.816 m, angle -2*pi/320.
! ELEGANT's CSBEND takes the arc length and the edge angles explicitly:
!   L = chord * (ang/2) / sin(ang/2),  e1 = e2 = ang/2.
% pi 2 * 320 / chs sto ang
% 1.816 ang 2 / * ang 2 / sin / sto lb0

! Matching-section drift lengths (as in RCSV6S0.bmad)
% 6.86920058362181329                       sto lmqa
% 1.95347170119514524 1.019666667 + 0.744583 + sto lmqa1
% 4.59154633687524161 1.019666667 + 0.744583 + sto lmqa2
% 2.52291632698884705 1.019666667 + 0.744583 + sto lmqa3

! ------------------------------------------------------------------
! Apertures
! ------------------------------------------------------------------
AP16: MAXAMP, X_MAX=0.016, Y_MAX=0.016, ELLIPTICAL=1
AP50: MAXAMP, X_MAX=0.050, Y_MAX=0.050, ELLIPTICAL=1

! ------------------------------------------------------------------
! Arc elements
! ------------------------------------------------------------------
B0: CSBEND, L="lb0", ANGLE="ang", E1="ang 2 /", E2="ang 2 /", FINT=0
QD: KQUAD, L=0.71, K1="kqdarc"
QF: KQUAD, L=0.71, K1="kqfarc"
SD: KSEXT, L=0.2, K2="ksdarc"
SF: KSEXT, L=0.2, K2="ksfarc"

SDS: EDRIFT, L=0.2          ! sextupole-length drift (arc-end cells)
SFS: EDRIFT, L=0.2
COR: EKICKER, L=0.3078

DLO:  EDRIFT, L=0.09595
QLO:  EDRIFT, L=0.055
BPM:  MONI,   L=0.02
SBM:  EDRIFT, L=0.02                       ! old arc BPM slot
CLO:  EDRIFT, L=0.0126
CLOB: EDRIFT, L="0.0126 0.05 +"
SLO:  EDRIFT, L=0.05
DBEL: EDRIFT, L="0.291064 0.0006 2 / +"
VACT: EDRIFT, L="0.28411 0.025 -"
DSQ:  EDRIFT, L="0.059654 0.025 - 0.02 -"

! ------------------------------------------------------------------
! Straight-section elements (shared by both straights)
! ------------------------------------------------------------------
MQF21: KQUAD, L=0.47, K1="kmqf21"
MQD11: KQUAD, L=0.71, K1="kmqd11"
MQD21: KQUAD, L=0.71, K1="kmqd21"

! Large-bore (50 mm) quads; MQF11_LB is used twice per straight.
MQF11_LB: KQUAD, L=0.71, K1="kmqf11_lb"
QDS_LB:   KQUAD, L=0.71, K1="kqds_lb"
QFS_LB:   KQUAD, L=0.71, K1="kqfs_lb"

MQA:  EDRIFT, L="lmqa"
MQA1: EDRIFT, L="lmqa1"
MQA2: EDRIFT, L="lmqa2"
MQA3: EDRIFT, L="lmqa3"
MQA4: EDRIFT, L="0.453 0.4206255 +"

STRRF2:       EDRIFT, L=3.7735
RFC_D:        EDRIFT, L=1.0         ! dummy cavity slot
STRRF2_SHORT: EDRIFT, L=3.0735

! SRF cavity (5-cell): 8 in total, two per RF drift slot, in the
! extraction & RF straight only (INSERTION_EXT). The injection straight
! has dummy slots (RFC_D). 1.12 MV each (tracking placeholder),
! h = 2971 -> 591.0248 MHz.
RFC: RFCA, L=1.0, VOLT=1.12e6, FREQ=5.91024829586969495E+008, &
     BODY_FOCUS_MODEL="SRS", STANDING_WAVE=1, END1_FOCUS=1, END2_FOCUS=1

MBEG0: MARK
MEND0: MARK
MBEG:  MARK
MEND:  MARK
END:   MARK

! Injection straight: kicker pipes
MQA_00: EDRIFT, L=0.4
MQA_US: EDRIFT, L=1.0
MQA_DS: EDRIFT, L="lmqa 1.0 - 0.4 -"
MQA1_IL_A: EDRIFT, L="lmqa1 2 / 0.4 -"
MQA1_IL_B: EDRIFT, L="lmqa1 2 / 0.4 -"
MAR_SEP: MARK
MAR_OFF: MARK
IS_HKI01:   EKICKER, L=0.8
IS_MAR_HKI: MARK

! Extraction kickers and pipes
ES_HKI01: EKICKER, L=0.8
ES_HKI02: EKICKER, L=0.8
ES_HKI03: EKICKER, L=0.8
ES_PIP01_A: EDRIFT, L="lmqa2 3.6 -"
ES_PIP01_B: EDRIFT, L=0.2
ES_PIP01_C: EDRIFT, L=1.8
ES_PIP02_A: EDRIFT, L="lmqa1 2 / 0.4 -"
ES_PIP02_B: EDRIFT, L="lmqa1 2 / 0.4 -"
ES_PIP03: EDRIFT, L="lmqa 5.1 -"
ES_PIP04: EDRIFT, L=3.9
ES_PIP05: EDRIFT, L=1.2

! ------------------------------------------------------------------
! Lines
! ------------------------------------------------------------------
B: LINE=(DLO, B0, DLO)

ARCMAIN: LINE=(QF, QLO, SBM, CLOB, COR, CLO, DBEL, B, VACT, SLO, SD, SLO, DSQ, BPM, QLO, &
               QD, QLO, SBM, CLOB, COR, CLO, DBEL, B, VACT, SLO, SF, SLO, DSQ, BPM, QLO)

! Arc-end cells: same geometry, sextupoles replaced by drifts
BEARCMAIN: LINE=(QF, QLO, SBM, CLOB, COR, CLO, DBEL, B, VACT, SLO, SDS, SLO, DSQ, BPM, QLO, &
                 QD, QLO, SBM, CLOB, COR, CLO, DBEL, B, VACT, SLO, SFS, SLO, DSQ, BPM, QLO)

ARC: LINE=(BEARCMAIN, 78*ARCMAIN, BEARCMAIN)

MQA1_IL:  LINE=(MQA1_IL_A, IS_HKI01, IS_MAR_HKI, MQA1_IL_B)
ES_PIP01: LINE=(ES_PIP01_A, ES_HKI01, ES_PIP01_B, ES_HKI02, ES_PIP01_C)
ES_PIP02: LINE=(ES_PIP02_A, ES_HKI03, ES_PIP02_B)

! Injection straight (dummy cavity slots only)
INSERTION_INJ: LINE=(MBEG0, QF, QLO, BPM, CLO, COR, CLO, &
  MQA_00, MAR_SEP, MQA_US, MAR_SEP, MQA_DS, QLO, &
  MQD21, QLO, BPM, CLO, COR, CLO, &
  MQA1_IL, QLO, &
  MQF21, QLO, BPM, CLO, COR, CLO, &
  MQA2, QLO, &
  MQD11, QLO, BPM, CLO, COR, CLO, &
  MQA3, QLO, &
  AP50, MQF11_LB, AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC_D, RFC_D, STRRF2, MQA4, QLO, &
  AP50, QDS_LB,   AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC_D, RFC_D, STRRF2, MQA4, QLO, &
  AP50, QFS_LB,   AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC_D, RFC_D, STRRF2, MQA4, QLO, &
  AP50, QDS_LB,   AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC_D, RFC_D, STRRF2, MQA4, QLO, &
  AP50, MQF11_LB, AP16, QLO, BPM, CLO, COR, CLO, &
  MQA3, QLO, &
  MQD11, QLO, BPM, CLO, COR, CLO, &
  ES_PIP01, QLO, &
  MQF21, QLO, BPM, CLO, COR, CLO, &
  ES_PIP02, QLO, &
  MQD21, QLO, BPM, CLO, COR, CLO, &
  MAR_OFF, ES_PIP03, MAR_SEP, ES_PIP04, MAR_SEP, ES_PIP05, QLO, &
  MEND0)

! RF / extraction straight (real cavities)
INSERTION_EXT: LINE=(MBEG, QF, QLO, BPM, CLO, COR, CLO, &
  MQA, QLO, &
  MQD21, QLO, BPM, CLO, COR, CLO, &
  MQA1, QLO, &
  MQF21, QLO, BPM, CLO, COR, CLO, &
  MQA2, QLO, &
  MQD11, QLO, BPM, CLO, COR, CLO, &
  MQA3, QLO, &
  AP50, MQF11_LB, AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC, RFC, STRRF2, MQA4, QLO, &
  AP50, QDS_LB,   AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC, RFC, STRRF2, MQA4, QLO, &
  AP50, QFS_LB,   AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC, RFC, STRRF2, MQA4, QLO, &
  AP50, QDS_LB,   AP16, QLO, BPM, CLO, COR, CLO, STRRF2_SHORT, RFC, RFC, STRRF2, MQA4, QLO, &
  AP50, MQF11_LB, AP16, QLO, BPM, CLO, COR, CLO, &
  MQA3, QLO, &
  MQD11, QLO, BPM, CLO, COR, CLO, &
  ES_PIP01, QLO, &
  MQF21, QLO, BPM, CLO, COR, CLO, &
  ES_PIP02, QLO, &
  MQD21, QLO, BPM, CLO, COR, CLO, &
  MAR_OFF, ES_PIP03, MAR_SEP, ES_PIP04, MAR_SEP, ES_PIP05, QLO, &
  MEND)

FULL_RING: LINE=(AP16, INSERTION_INJ, ARC, INSERTION_EXT, ARC, END)
