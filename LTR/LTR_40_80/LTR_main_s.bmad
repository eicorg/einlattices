!-------------------------------------------------------
! LTR_main.bmad  —  sequential drift-based layout
! Converted from superimpose-on-pipe representation
! Simplified standalone version: beam parameters inlined above, no companion tao.init file needed (already matched).
!-------------------------------------------------------

! Initial beam parameters (inlined from beam_pre_inj.bmad -- gun/pre-injector interface)
parameter[geometry]      = Open
parameter[p0c]           = 7.49999825920029E8
parameter[particle]      = Electron
parameter[no_end_marker] = T

BEGINNING[BETA_A]  =  9.06696
BEGINNING[ALPHA_A] = -0.587814
BEGINNING[BETA_B]  =  20.3877
BEGINNING[ALPHA_B] = -0.747937
BEGINNING[ETA_X]   =  0.0165
BEGINNING[ETAP_X]  = -0.011
BEGINNING[ETA_Y]   =  0.0
BEGINNING[ETAP_Y]  =  0.0

!-------------------------------------------------------
! Element definitions
!-------------------------------------------------------

! Quadrupoles
ltr_qua05: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = -3.468785164
ltr_qua06: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 =  4.116425185
ltr_qua07: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 =  1.67260196
ltr_qua08: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = -1.596465691
ltr_qua09: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 =  0.5502881912
ltr_qua10: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = -0.5691837908
ltr_qua11: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = -0.07596967789
! Injection quads (larger aperture)
ltr_qua12: Quadrupole, L = 0.3, aperture_type = elliptical, aperture = 18.16e-3, K1 =  9.67980720998891764E-001
ltr_qua13: Quadrupole, L = 0.3, aperture_type = elliptical, aperture = 18.16e-3, K1 = -1.60218524933524309E+000
ltr_qua14: Quadrupole, L = 0.3, aperture_type = elliptical, aperture = 18.16e-3, K1 =  2.05010357425672796E+000
ltr_qua15: Quadrupole, L = 0.3, aperture_type = elliptical, aperture = 18.16e-3, K1 = -1.27005620912266548E+000
! Equidistant replacement quads (K1 to be optimized)
ltr_qua01: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = 0
ltr_qua02: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = 0
ltr_qua03: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = 0
ltr_qua04: Quadrupole, L = 0.3, aperture = 0.01816, aperture_type = Elliptical, K1 = 0

! Correctors
ltr_cor00:   KICKER, L = 0.23
ltr_cor00_s: KICKER, L = 0.11
ltr_cor05: ltr_cor00
ltr_cor06: ltr_cor00
ltr_cor07: ltr_cor00
ltr_cor08: ltr_cor00
ltr_cor09: ltr_cor00
ltr_cor10: ltr_cor00
ltr_cor11: ltr_cor00
ltr_cor12: ltr_cor00
ltr_cor13: ltr_cor00_s
ltr_cor01: ltr_cor00
ltr_cor02: ltr_cor00
ltr_cor03: ltr_cor00
ltr_cor04: ltr_cor00

! BPMs
ltr_bpm00: MONITOR, L = 0.1
ltr_bpm05: ltr_bpm00
ltr_bpm06: ltr_bpm00
ltr_bpm07: ltr_bpm00
ltr_bpm08: ltr_bpm00
ltr_bpm09: ltr_bpm00
ltr_bpm10: ltr_bpm00
ltr_bpm11: ltr_bpm00
ltr_bpm12: ltr_bpm00
ltr_bpm13: ltr_bpm00
ltr_bpm14: ltr_bpm00
ltr_bpm15: ltr_bpm00
ltr_bpm16: ltr_bpm00
ltr_bpm17: ltr_bpm00
ltr_bpm01: ltr_bpm00
ltr_bpm02: ltr_bpm00
ltr_bpm03: ltr_bpm00
ltr_bpm04: ltr_bpm00

! Dipoles
ltr_dip01: RBEND, L = 0.8

! Penner merger SBENDs (controlled by O_MG overlay)
ltr_dip02: SBEND, L = 0.8, aperture_type = elliptical, aperture = 18.16e-3
ltr_dip03: SBEND, L = 0.8, aperture_type = elliptical, aperture = 18.16e-3
ltr_dip04: SBEND, L = 0.8, aperture_type = elliptical, aperture = 18.16e-3

! Markers
ltr_mark_beg: MARKER
ltr_mark_p1:  MARKER
ltr_mark_mid: MARKER
ltr_mark_p2:  MARKER

! Injection patch
ltr_pat01: patch, x_offset = -6.5E-3, x_pitch = 2.0E-3
ltr_pat01[X_OFFSET] =  3.09000000000000004E-002  ! Not used in optimizing
ltr_pat01[X_PITCH]  = -4.39130560846672999E-003  ! Not used in optimizing

! Injection kicker

!-------------------------------------------------------
! Modified Penner bend merger overlay
!-------------------------------------------------------

O_MG: overlay = {
  ltr_dip02[G]:  gg,
  ltr_dip03[G]: -gg,
  ltr_dip04[G]:  gg,
  ltr_dip02[E1]: gg*0.8*0.5,
  ltr_dip02[E2]: gg*0.8*0.5,
  ltr_dip03[E1]: -0.5*gg*0.8,
  ltr_dip03[E2]: -0.5*gg*0.8,
  ltr_dip04[E1]: gg*0.8*0.5,
  ltr_dip04[E2]: gg*0.8*0.5},
  var = {gg},
  gg = -1.90690761784588297E-001

O_MG[GG] = 1.90887501963897477E-001  ! Not used in optimizing

