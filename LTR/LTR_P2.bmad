!-------------------------------------------------------
! Call files

call, file = beam_BAR.bmad
call, file = RCS_lattice.bmad

!--------------------------------------------------------------------------------
!LTR


!ltr segments
ltr_pip06: PIPE, L = 0.3
ltr_pip07: PIPE, L = 5.2+6.064+11.72
!ltr inj segments
ltr_pip08: PIPE, L = 1.0, aperture_type = elliptical, aperture = 18.16e-3
ltr_pip09: PIPE, L = 3.5, aperture_type = elliptical, aperture = 18.16e-3	! used to be 5 m (03) / 3.5 (04)
ltr_pip10: PIPE, L = 3.5, aperture_type = elliptical, aperture = 18.16e-3	! used to be 5 m (03) / 3.5 (04)

!elements
ltr_qua00: Quadrupole, L = 0.30, aperture = 0.01816, aperture_type = Elliptical
ltr_cor00: KICKER, L = 0.23
ltr_cor00_s: KICKER, L = 0.11 !short corrector
ltr_bpm00: MONITOR, L = 0.1

!Markers
ltr_mark_p2: MARKER

!ltr quads
ltr_qua11: ltr_qua00, K1 = -1.99809286, superimpose, ref = ltr_pip07, offset=0.0+6.064, ref_origin=beginning, ele_origin=beginning
ltr_qua12: ltr_qua00, K1 = 1.963948459, superimpose, ref = ltr_pip07, offset=0.5+6.064, ref_origin=beginning, ele_origin=beginning
ltr_qua13: ltr_qua00, K1 = 0.4741387231, superimpose, ref = ltr_pip07, offset=1.9+6.064+11.72, ref_origin=beginning, ele_origin=beginning
ltr_qua14: ltr_qua00, K1 = -0.9052143414, superimpose, ref = ltr_pip07, offset=3.3+6.064+11.72, ref_origin=beginning, ele_origin=beginning
ltr_qua15: ltr_qua00, K1 = -0.07115047211, superimpose, ref = ltr_pip07, offset=4.7+6.064+11.72, ref_origin=beginning, ele_origin=beginning
!ltr inj quads
ltr_qua16: ltr_qua00, k1 = 9.67980720998891764E-001, superimpose, ref = ltr_pip09, offset=1.665+0.085, ref_origin=beginning, ele_origin=beginning
ltr_qua17: ltr_qua00, k1 = -1.60218524933524309E+000, superimpose, ref = ltr_pip09, offset=-0.265-0.085, ref_origin=end, ele_origin=end
ltr_qua18: ltr_qua00, k1 = 2.05010357425672796E+000, superimpose, ref = ltr_pip10, offset=0.265+0.085, ref_origin=beginning, ele_origin=beginning
ltr_qua19: ltr_qua00, k1 = -1.27005620912266548E+000, superimpose, ref = ltr_pip10, offset=-1.665-0.085-0.263386, ref_origin=end, ele_origin=end

!ltr corr
ltr_cor06: ltr_cor00, superimpose, ref = ltr_pip07, offset=3.0+0.06, ref_origin=beginning, ele_origin=beginning
ltr_cor07: ltr_cor00, superimpose, ref = ltr_pip07, offset=6.864+0.06, ref_origin=beginning, ele_origin=beginning
ltr_cor08: ltr_cor00, superimpose, ref = ltr_pip07, offset=21.384+0.06, ref_origin=beginning, ele_origin=beginning
!ltr inj corr
ltr_cor09: ltr_cor00, superimpose, ref = ltr_pip08, offset=-0.28, ref_origin=end, ele_origin=beginning
ltr_cor10: ltr_cor00, superimpose, ref = ltr_pip09, offset=1.75-0.05-0.23, ref_origin=beginning, ele_origin=beginning
ltr_cor11: ltr_cor00, superimpose, ref = ltr_pip10, offset=0.7, ref_origin=beginning, ele_origin=beginning
ltr_cor12: ltr_cor00_s, superimpose, ref = ltr_pip10, offset=-1.665-0.085-0.263386+0.129424+0.11, ref_origin=end, ele_origin=end

!ltr bpm

ltr_bpm07: ltr_bpm00, superimpose, ref = ltr_pip07, offset=3.0+0.06+0.28, ref_origin=beginning, ele_origin=beginning
ltr_bpm08: ltr_bpm00, superimpose, ref = ltr_pip07, offset=6.864+0.06+0.28, ref_origin=beginning, ele_origin=beginning
ltr_bpm09: ltr_bpm00, superimpose, ref = ltr_pip07, offset=21.384+0.06+0.28, ref_origin=beginning, ele_origin=beginning
!ltr inj bpm
ltr_bpm10: ltr_bpm00, superimpose, ref = ltr_pip08, offset=-0.43, ref_origin=end, ele_origin=beginning
ltr_bpm11: ltr_bpm00, superimpose, ref = ltr_pip09, offset=0.05, ref_origin=beginning, ele_origin=beginning
ltr_bpm12: ltr_bpm00, superimpose, ref = ltr_pip09, offset=2.45, ref_origin=beginning, ele_origin=center
ltr_bpm13: ltr_bpm00, superimpose, ref = ltr_pip10, offset=0.05, ref_origin=beginning, ele_origin=beginning !overlap fixed
ltr_bpm14: ltr_bpm00, superimpose, ref = ltr_pip10, offset=0.75+0.23, ref_origin=beginning, ele_origin=beginning
ltr_bpm15: ltr_bpm00, superimpose, ref = ltr_pip10, offset=-0.3, ref_origin=end, ele_origin=end


!ltr dipoles
ltr_dip01: RBEND, L = 0.4, ANGLE = 0.07
ltr_dip02: RBEND, L = 0.4, ANGLE = -0.07
ltr_dip03: RBEND, L = 0.8
!ltr inj dipoles
ltr_dip04: SBEND, L = 0.8, aperture_type = elliptical, aperture = 18.16e-3
ltr_dip05: SBEND, L = 0.8, aperture_type = elliptical, aperture = 18.16e-3
ltr_dip06: SBEND, L = 0.8, aperture_type = elliptical, aperture = 18.16e-3

!ltr inj patch
ltr_pat01: patch, x_offset = -6.5E-3, x_pitch = 2.0E-3
ltr_pat01[X_OFFSET] = 3.09000000000000004E-002   ! Not used in optimizing
ltr_pat01[X_PITCH] = -4.39130560846672999E-003   ! Not used in optimizing

!ltr inj kicker value
ltr_rcs_kicker[HKICK] =  -2.94538982308908612E-003   ! Not used in optimizing


!-------------------------------------------------------
! Modified Penner bend merger

O_MG: overlay = {
  ltr_dip04[G]: gg,
  ltr_dip05[G]: -gg,
  ltr_dip06[G]: gg,
  ltr_dip04[E1]: gg*0.8*0.5,
  ltr_dip04[E2]: gg*0.8*0.5,
  ltr_dip05[E1]: -0.5*gg*0.8,
  ltr_dip05[E2]: -0.5*gg*0.8,
  ltr_dip06[E1]: gg*0.8*0.5,
  ltr_dip06[E2]: gg*0.8*0.5},
  var = {gg},
  gg = -1.90690761784588297E-001

 O_MG[GG] = 1.90887501963897477E-001   ! Not used in optimizing


section_3: LINE = ( ltr_mark_p2, ltr_pip06, ltr_dip03, ltr_pip07 ) !P2 to penner bend
section_4: LINE = ( ltr_pip08, ltr_dip04, ltr_pip09, ltr_dip05, ltr_pip10, ltr_dip06, ltr_pat01, RING_DS ) !Penner bend and RCS injection

LTR_P2: line = ( section_3, section_4 )

use, LTR_P2
