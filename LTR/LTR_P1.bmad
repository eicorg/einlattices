!-------------------------------------------------------
! Call files

call, file = beam_pre_inj.bmad
!call, file = RCS_lattice.bmad

!--------------------------------------------------------------------------------
!LTR


!ltr segments
ltr_pip01: PIPE, L = 2.5
ltr_pip02: PIPE, L = 1.5
ltr_pip03: PIPE, L = 2.3
ltr_pip04: PIPE, L = 0.3


!elements
ltr_qua00: Quadrupole, L = 0.30, aperture = 0.01816, aperture_type = Elliptical
ltr_cor00: KICKER, L = 0.23
ltr_cor00_s: KICKER, L = 0.11 !short corrector
ltr_bpm00: MONITOR, L = 0.1

!Markers
ltr_mark_beg: MARKER
ltr_mark_p1: MARKER




!ltr quads
ltr_qua01: ltr_qua00, K1 =  4.443611363, superimpose, ref = ltr_pip01, offset=0.2, ref_origin=beginning, ele_origin=beginning
ltr_qua02: ltr_qua00, K1 =  -2.576280053, superimpose, ref = ltr_pip01, offset=0.7, ref_origin=beginning, ele_origin=beginning
ltr_qua03: ltr_qua00, K1 =  -0.7411343281, superimpose, ref = ltr_pip01, offset=1.5, ref_origin=beginning, ele_origin=beginning
ltr_qua04: ltr_qua00, K1 =  -1.809578102, superimpose, ref = ltr_pip01, offset=2.0, ref_origin=beginning, ele_origin=beginning
ltr_qua05: ltr_qua00, K1 = 0.5442767418, superimpose, ref = ltr_pip02, offset=0.2, ref_origin=beginning, ele_origin=beginning
ltr_qua06: ltr_qua00, K1 = 4.051061054, superimpose, ref = ltr_pip02, offset=1.0, ref_origin=beginning, ele_origin=beginning
ltr_qua07: ltr_qua00, K1 = -5.071152705, superimpose, ref = ltr_pip03, offset=0.2, ref_origin=beginning, ele_origin=beginning
ltr_qua08: ltr_qua00, K1 = 1.523621114, superimpose, ref = ltr_pip03, offset=0.7, ref_origin=beginning, ele_origin=beginning
ltr_qua09: ltr_qua00, K1 = 4.839731404, superimpose, ref = ltr_pip03, offset=1.5, ref_origin=beginning, ele_origin=beginning
ltr_qua10: ltr_qua00, K1 = -1.709708008, superimpose, ref = ltr_pip03, offset=2.0, ref_origin=beginning, ele_origin=beginning

!ltr corr
ltr_cor01: ltr_cor00, superimpose, ref = ltr_pip01, offset=1.0+0.06, ref_origin=beginning, ele_origin=beginning
ltr_cor02: ltr_cor00, superimpose, ref = ltr_pip02, offset=0.5+0.06, ref_origin=beginning, ele_origin=beginning
ltr_cor03: ltr_cor00, superimpose, ref = ltr_pip03, offset=1.0+0.06, ref_origin=beginning, ele_origin=beginning


!ltr bpm
ltr_bpm01: ltr_bpm00, superimpose, ref = ltr_pip01, offset=1.0+0.06+0.28, ref_origin=beginning, ele_origin=beginning
ltr_bpm02: ltr_bpm00, superimpose, ref = ltr_pip02, offset=0.5+0.06+0.28, ref_origin=beginning, ele_origin=beginning
ltr_bpm03: ltr_bpm00, superimpose, ref = ltr_pip03, offset=1.0+0.06+0.28, ref_origin=beginning, ele_origin=beginning


!ltr dipoles
ltr_dip01: RBEND, L = 0.4, ANGLE = 0.07
ltr_dip02: RBEND, L = 0.4, ANGLE = -0.07



section_1: LINE = ( ltr_mark_beg, ltr_pip01, ltr_dip01, ltr_pip02, ltr_dip02, ltr_pip03, ltr_pip04, ltr_mark_p1 ) !preinjector to P1


LTR_P1: line = ( section_1 )

use, LTR_P1
