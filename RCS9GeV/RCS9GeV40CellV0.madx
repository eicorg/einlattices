lmdif, calls=5000, tolerance=1.E-12;
   ENDMATCH;

USE, PERIOD = Insertion; TWISS,CHROM, SEQUENCE= Insertion, BETA0=BETA_CELL;

//stop;


USE, PERIOD=RING;

MATCH, USE_MACRO;
      VARY, NAME=KSFarc, STEP = 0.00001;
      VARY, NAME=KSDarc, STEP = 0.00001;
     // VARY, NAME=KSFstr, STEP = 0.00001;
     // VARY, NAME=KSDstr, STEP = 0.00001;

      B5: MACRO = { TWISS, CHROM, SEQUENCE=RING;}

      // Setting the chromaticities.
      CONSTRAINT, WEIGHT=1000.0, EXPR= TABLE(SUMM, DQ1) =1;
      CONSTRAINT, WEIGHT=1000.0, EXPR= TABLE(SUMM, DQ2) =1;
      lmdif, calls=5000, tolerance=1.E-12;
    //  SIMPLEX, CALLS = 5000, TOLERANCE = 1.E-12;
   ENDMATCH;
*/

USE, PERIOD=ring;
//TWISS, SEQUENCE=RING, CHROM, RMATRIX;
//PLOT, HAXIS, HMIN=723,HMAX=880, VAXIS1=BETX,BETY,VAXIS2=DX,HAXIS=S,COLOUR=100,INTERPOLATE=TRUE, TABLE=twiss,TITLE="Straight";
//stop;

//EOPTION, SEED = 99, ADD=FALSE;
//SELECT, FLAG = ERROR, CLASS = rbend;
//EALIGN,  DPSI:=4.0e-4*TGAUSS(2);
select, flag=my_model, column=name,keyword,s,l,angle,betx,alfx,bety,alfy,muy,y,k1l,k2l,h1,h2,x,px,py,DX,WX;

//select, flag=my_model2, column=name,keyword,s,l,betx,bety,DX;


//select, flag=my_model, class=sextupole, column=name,keyword,s,l,betx,alfx,bety,alfy,DX,MUX;
SAVEBETA, LABEL=BETA_CELL2, PLACE=#E;
twiss, chrom, sequence=ring, table=my_model, file="RCS9GeV40CellV0.twiss";

value,   KQFarc,   KQDarc, KQFstr, KQDstr, KMQF11, KMQD11, KMQF21, KMQD21, KSFarc, KSDarc;
value, table(my_model,mend,muy)-table(my_model,mbeg,muy);
value, table(my_model,mend,mux)-table(my_model,mbeg,mux);
Qy0 = TABLE(SUMM,Q2);
Qx0 = TABLE(SUMM,Q1);
CHx0 = TABLE(SUMM,DQ1);
CHy0 = TABLE(SUMM,DQ2);

value, emit_ratio0;
value, TABLE(SUMM,SYNCH_5)/(TABLE(SUMM,SYNCH_2)-TABLE(SUMM,SYNCH_4));
survey, sequence=RING, file="RCS9GeV40CellV0_survey.dat";
save, sequence=ring, file="RCS9GeV40CellV0.seq";
stop;