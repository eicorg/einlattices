select, flag=my_model, column=name,keyword,s,l,angle,betx,alfx,bety,alfy,muy,y,k1l,k2l,h1,h2,x,px,py,DX,WX;

//select, flag=my_model2, column=name,keyword,s,l,betx,bety,DX;


//select, flag=my_model, class=sextupole, column=name,keyword,s,l,betx,alfx,bety,alfy,DX,MUX;
SAVEBETA, LABEL=BETA_CELL2, PLACE=#E;
twiss, chrom, sequence=ring, table=my_model, file= "RCS9GeV40CellV1.twiss";

value,   KQFarc,   KQDarc, KQFstr, KQDstr, KMQF11, KMQD11, KMQF21, KMQD21, KSFarc, KSDarc;
value, table(my_model,mend,muy)-table(my_model,mbeg,muy);
value, table(my_model,mend,mux)-table(my_model,mbeg,mux);
Qy0 = TABLE(SUMM,Q2);
Qx0 = TABLE(SUMM,Q1);
CHx0 = TABLE(SUMM,DQ1);
CHy0 = TABLE(SUMM,DQ2);

value, emit_ratio0;
value, TABLE(SUMM,SYNCH_5)/(TABLE(SUMM,SYNCH_2)-TABLE(SUMM,SYNCH_4));
survey, sequence=RING, file="RCS9GeV40CellV1_survey.dat";
save, sequence=ring, file="RCS9GeV40CellV1.seq";
stop;
