// File generated by: write_lattice_in_foreign_format;
// Bmad lattice file: RCS_9GeV40Cell.bmad;

beam_def: Beam, Particle = Electron, Energy =  9, Npart = 0.00000000000000000E+000;

option, -info, -echo;


! Best DA and Pol
kqfarc = 2.88176383166236894E-001;
kqdarc = -2.86481699474450902E-001;
kmqd21 = -3.90042490920066043E-001;
kmqf21 = 7.75065476980501655E-001;
kmqd11 = -3.74997217054943266E-001;
kmqf11 = 6.40750062808364773E-001;
kqdstr = -5.27240337659555691E-001;
kqfstr = 4.38822308268922490E-001; 

kqfe2 = 2.92928013429660350E-001;
kqde1 = -2.46656344146840484E-001;
kqde0 = -2.59145637709897236E-001;
kqfe0 = 2.57381483601261118E-001;

ksdarc = 4.41109065698595337;
ksfarc = -2.07598400127251237;


!/ ARC Elements
b0: rbend, l = 1.816, angle = -0.01963495*80./40. ;
b0_weak: rbend, l = 1.816, angle = -0.01963495*3./2.;
b0_orig: rbend, l = 1.816, angle = -0.01963495;

qd: quadrupole, l = 0.71, k1 := kqdarc;
qf: quadrupole, l = 0.71, k1 := kqfarc;
sd: sextupole, l = 0.2, k2 := ksdarc;
sf: sextupole, l = 0.2, k2 := ksfarc;

sds: drift, l = 0.2;
sfs: drift, l = 0.2;
cor: kicker, l = 0.3078, hkick = 0, vkick = 0;


dlo: drift, l = 0.09595;
B: line=(DLO,B0,DLO);
B_weak: line=(DLO,B0_weak,DLO);

d_init_1: drift, l = 0.38743069;
d_init_2: drift, l = 2.2040780;
qlo: drift, l = 0.055;
bpm: monitor, l = 0.02;
clo: drift, l = 0.0126;
slo: drift, l = 0.05;
dbel: drift, l = 0.291064+0.0006/2+8.232289386/2*40./40.-0.0006883;
vact: drift, l = 0.28411;
dsq: drift, l = 0.059654;

! Dispersion Suppression Quads
QFE2: quadrupole, l = 0.71, k1 := kqfe2;
QDE0: quadrupole, l = 0.71, k1 := kqde0;
QFE0: quadrupole, l = 0.71, k1 := kqfe0;
QDE1: quadrupole, l = 0.71, k1 := kqde1;

ME1: marker;

ArcInit: line=(QFE2, QLO, BPM, CLO, COR, CLO, d_init_1, b0_orig, d_init_2, B_weak,VACT,SLO,SD,SLO,DSQ,QLO,
	       QDE0, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,QLO);
	       
ArcCellR2: line=(QFE2, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
                 QDE1, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,QLO);
		 
ArcCellR1: line=(QFE0, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
	         QDE1, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,QLO);
		 
ArcCellR0: line=(QFE0, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
                 QDE0, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,QLO);

ArcTail0: line=(QF, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
	        QDE0, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,ME1,QLO);
		
ArcCell0: line=(QFE0, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
                QDE1, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,QLO);
		
ArcCell1: line=(QFE0, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
	  	QDE1, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,QLO);

ArcFinal: line=(QFE2, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
                QDE0, QLO,BPM, CLO, COR, CLO, DBEL,B_weak,VACT,SLO,SF,SLO,DSQ,QLO);


ArcMain: line=(QF, QLO, BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SD,SLO,DSQ,QLO,
               QD, QLO,BPM, CLO, COR, CLO, DBEL,B,VACT,SLO,SF,SLO,DSQ,QLO);



//ARC: line=(ArcInit,38*ArcMain,ArcFinal);

ARC: line=(ArcInit,ArcCellR2,ArcCellR1,ArcCellR0,32*ArcMain,ArcTail0,ArcCell0,ArcCell1,ArcFinal);


//ARC: line=(ArcInit,ArcCellR2,36*ArcMain,ArcCell1,ArcFinal);







!/ Straight Section Elements
qfsh0: quadrupole, l = 0.235, k1 := kqfstr;
qfs: quadrupole, l = 0.47, k1 := kqfstr;
qds: quadrupole, l = 0.47, k1 := kqdstr;
mqf11: quadrupole, l = 0.47, k1 := kmqf11;
mqf21: quadrupole, l = 0.47, k1 := kmqf21;

mqd11: quadrupole, l = 0.71, k1 := kmqd11;
mqd21: quadrupole, l = 0.71, k1 := kmqd21;



mqa: drift, l = 6.86920058362181329;
mqa1: drift, l = 1.95347170119514524;
mqa2: drift, l = 4.59154633687524161;
mqa3: drift, l = 2.52291632698884705;
mqa4: drift, l = 0.453;
mqa5: drift, l = 5.867;

LCav = 1.2;
strrf: drift, l = 2.107;
rfc_d: drift, l = LCav;

mend: marker;
mbeg: marker;
rfc: rfcavity, l = LCav, volt = 30.12, lag = 0.5, harmon =  2971;
end: marker;
MEND0: marker;
MSS: marker;
! Injection line elements

MQA_00: drift, l =  0.4;
MAR.SEP: marker;
MQA_US: drift, l =  1.;
MQA_DS: drift, l =  5.46920058362181294;

MQA1_IL_1: drift, l =  5.76735850597572375E-001+0.275; !drift upstreadm of injection kicker
!Injection kicker
MQA1_IL_IK: kicker, l =  0.25;
MQA1_IL_2: drift, l =  5.76735850597572153E-001+0.275; !drift downstream of injection kicker



!Extraction line elements

ES.PIP01_1: drift, l =  9.91546336875332557E-001; !drift upstream of first extraction kicker
ES.PIP01_EK1003: kicker, l =  8.0E-001; ! first extraction kicker
ES.PIP01_2: drift, l =  2.0E-001;!drift between first and second extraction kicker
ES.PIP01_EK1004: kicker, l =  8.00E-001; ! second extraction kicker
ES.PIP01_3: drift, l =  1.79999999999995430E+000;!drift downstream of second extraction kicker
ES.PIP02_1: drift, l =  5.76735850597675404E-001;!drift upstream of third extraction kicker
ES.PIP02_EK1005: kicker, l =  8.00000000000000044E-001; !third extraction kicker
ES.PIP02_2: drift, l =  5.76735850597515309E-001;!drift downstream of third extraction kicker
MAR.OFF: marker;
ES.PIP03: drift, l =  1.76920058362181365E+000;!drift upstream of extraction septa
ES.PIP04: drift, l =  3.89999999999999991E+000;!drift roughly the distance of the two extraction septa where the aperture is not the same as the rest of the machine- placeholder for septa physical location for simulations without extraction
ES.PIP05: drift, l =  1.19999999999999996E+000;!drift downstream of extraction septa
END: marker;
mbeg0: marker;

//---------------------------------;




!---------------------------------;


Insertion2_KD: line = ( MBEG, QFE2, QLO, BPM, CLO, COR, CLO, MQA_00, MAR.SEP, MQA_US, MAR.SEP, MQA_DS,
QLO, MQD21, QLO, BPM, CLO, COR, CLO, MQA1_IL_1,MQA1_IL_IK, MQA1_IL_2,
QLO, MQF21, QLO, BPM, CLO, COR, CLO, MQA2,
QLO, MQD11, QLO, BPM, CLO, COR, CLO, MQA3,
QLO, MQF11, QLO, BPM, CLO, COR, CLO, MQA5,
QLO, QDS,   QLO, BPM, CLO, COR, CLO, MQA5, QLO, QFS, QLO, BPM, CLO, COR, CLO, MQA5,
QLO, QDS,   QLO, BPM, CLO, COR, CLO, MQA5, QLO, MSS,QFS);

Insertion1: line = (QLO, BPM, CLO, COR, CLO, MQA5,
QLO, QDS,   QLO, BPM, CLO, COR, CLO, MQA5, QLO, QFS, QLO, BPM, CLO, COR, CLO, MQA5,
QLO, QDS,   QLO, BPM, CLO, COR, CLO, MQA5,
QLO, MQF11, QLO, BPM, CLO, COR, CLO, MQA3,
QLO, MQD11, QLO, BPM, CLO, COR, CLO, MQA2,
QLO, MQF21, QLO, BPM, CLO, COR, CLO, MQA1,
QLO, MQD21, QLO, BPM, CLO, COR, CLO, MQA, QLO, MEND );



InsertionRF_KD: LINE = ( MBEG, QFE2, QLO, BPM, CLO, COR, CLO, MQA,QLO, MQD21, QLO, BPM, CLO, COR, CLO, MQA1,QLO, MQF21, QLO,
	BPM, CLO, COR, CLO, MQA2,QLO, MQD11, QLO, BPM, CLO, COR, CLO, MQA3,QLO, MQF11, QLO, BPM, CLO, COR, CLO,MQA5
	,QLO, QDS,   QLO, BPM, CLO, COR, CLO, STRRF,RFC,STRRF,MQA4, QLO, QFS, QLO, BPM, CLO, COR, CLO, MQA5,QLO, QDS,   QLO, BPM, CLO,
	COR, CLO, MQA5, QLO, QFS, QLO, BPM, CLO, COR, CLO, MQA5,QLO, QDS,   QLO, BPM, CLO, COR, CLO, MQA4, STRRF,RFC,STRRF, QLO, QFS, QLO, BPM,
	CLO, COR, CLO, MQA5,QLO, QDS,   QLO, BPM, CLO, COR, CLO, MQA5,QLO, MQF11, QLO, BPM, CLO, COR, CLO, MQA3,QLO, MQD11,
	QLO, BPM, CLO, COR, CLO, ES.PIP01_1, ES.PIP01_EK1003, ES.PIP01_2,
   ES.PIP01_EK1004, ES.PIP01_3, QLO, MQF21, QLO, BPM, CLO, COR, CLO,
   ES.PIP02_1, ES.PIP02_EK1005, ES.PIP02_2, QLO, MQD21, QLO, BPM, CLO, COR,
   CLO, MAR.OFF, ES.PIP03, MAR.SEP, ES.PIP04, MAR.SEP, ES.PIP05, QLO, MEND );


RING0: line=(ARC,ARC);

RING: line=(Insertion2_KD,Insertion1,ARC,InsertionRF_KD,ARC);

USE, PERIOD=RING;


