!ZOUT  NPrint  D_PHI  Z1  Z2  X1  Y1  X2  Y2
ZOUT  5000  90  100  500  0 0 0  0

ZLIMIT  100
!CHARGE  -1  1

!@subs 1 4 28 6 29
INPUT 9 19999 0.5 4.7529637582e-01 5000 232 ! r=6 mm, 300 ps with 3 sigma_l.2 nC or 450ps with 1.7 nC, phi_max(half of bunch length)=154.224 --> 1ns; transverse 6 mm in radius with 1 sigma cut off
!
! OUTPUT  type  1=text  /  5=pargraf
!
OUTPUT  5
!
!
!SCHEFF  I_T[A]  Delta_R_SC  Delta_Z_SC  N_R  N_Z  N_bunch  L_bunch  RingOption  MeshFactor  R_wall  b, for I_T=Q*f0, f0=1.3007643GHz, 15nc-->19.5115A
SCHEFF 4.855 1.5 30 20  400  0  0  7  1.3  0  0   !1.2 nC=3.42@2956  for 20k particles; 7 for photocathode
!
!!START  Phi_0  Delta_Phi  NumberOfSteps  SpaceChargeSteps  OutputSteps
START  0  2  3500  1  50 !before SHB tot=7000: 1.52 m: between dipole at sol
save 0

SCHEFF  4.855 3.1 30 20  400  0  0  3  1.3  0  0   !15 nC=19.5115  for 20k particles ; 3 for no cathode
restart 2 5000 1 50 0 0 ! tot=10000+7000=17000 sol before buncher
save 1


SCHEFF  4.855 3.1 20 20  100  0  0  3  1.3  0  0   !15 nC=19.5115  end to before the chicane matching quads
restart 5 2000 1 50 0 1 ! total=1700*8+17000= 27000 before the sol into capture taper tot=15000+7500=22500 : before the buncher focusing sol
save 2



SCHEFF  4.855 2.1 2 20  20  0  0  3  1.2  0  0   !  1.3 AWA exit
restart 5 3944 1 50 0 2 !  total=27000+ 3860*5=46300
save 3



SCHEFF  4.855 2.1 2 20  20  0  0  3  1.1  0  0   !  end to the end of the 1st ACC
restart 5 3500 1 50 0 3 ! total=46300+ 3080*5=61700
save 4





SCHEFF  4.855 2.1 2 20  20  0  0  3  1.1  0  0   !15 nC=19.5115 end to the end of the 2st ACC
restart 5 2760 1 50 0 4 !   total=61700+19600=73200 !2850
save 5



SCHEFF  4.855 2.1 2 20  20  0  0  3  1.1  0  0   !15 nC=19.5115 end to the end of the 3st ACC
